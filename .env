# Anthropic API key (required for the engineer's brain)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for radio conversations
ENGINEER_MODEL=claude-sonnet-4-6

# What the engineer calls you
DRIVER_NAME=mate

# HTTP + WebSocket port for the dashboard
HTTP_PORT=8080

# F1 telemetry (Settings > Telemetry: UDP on, IP = this machine, port below)
# UDP Format: 2025, or 2026 if you have the 2026 Season Pack.
F1_UDP_PORT=20777

# Push-to-talk button mask from F1's BUTN event.
# Default 0x00100000 = "UDP Action 1" (bind it to any free wheel/controller button in F1's controls).
# Other useful values: 0x4000 = R3 click, 0x0080 = d-pad down.
F1_PTT_MASK=0x00100000

# PTT behavior: hold (press = mic open, release = send) or toggle (press once to open, again to send)
PTT_MODE=hold

# GT7: IP address of your PS5 on the LAN (leave blank to disable GT7 listener)
GT7_PS5_IP=
GT7_RECEIVE_PORT=33740
GT7_SEND_PORT=33739

# How much the engineer talks unprompted.
#   off     only when asked
#   low     key moments only, 45s minimum gap, important and urgent calls
#   medium  regular updates, 18s gap
#   high    constant coaching, 7s gap, includes corner by corner feedback
# Changeable live from the dashboard; this is just the startup value.
FEEDBACK_LEVEL=medium

# Optional: a real engineer voice via ElevenLabs. Leave blank to use the OS
# voice, which picks the best British voice installed (Daniel or Oliver on macOS).
# Get a voice ID from https://elevenlabs.io/app/voices
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5