# Anthropic API key for the engineer (server side only)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
DRIVER_NAME=Charlie

# WebSocket URL of the bridge (exposed to the browser)
NEXT_PUBLIC_BRIDGE_WS_URL=ws://localhost:8765

# Optional: real British engineer voice via ElevenLabs.
# Leave blank to use the OS voice (Daniel/Oliver on macOS).
# Get a voice ID from https://elevenlabs.io/app/voices
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
